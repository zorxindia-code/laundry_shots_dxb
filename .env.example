# Copy to .env.local and adjust for your environment.

# Public base URL, used for canonical / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (server-only). The enquiry form POSTs JSON
# { name, phone, email, service, message, source, submittedAt } to this URL
# (a form service, automation webhook or your own API). Leave unset and the
# form tells visitors online enquiries aren't connected — it never fakes success.
CONTACT_FORM_ENDPOINT=
# Optional: sent as "Authorization: Bearer <token>".
CONTACT_FORM_TOKEN=
